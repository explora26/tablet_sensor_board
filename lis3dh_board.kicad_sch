  (text "J1 -> NanoPC-T4 40-pin\n1: VIN  -> pin 2  (5V)\n2: GND  -> pin 6\n3: SCL  -> pin 5  (I2C2_SCL, 3V)\n4: SDA  -> pin 3  (I2C2_SDA, 3V)\n5: INT1 -> pin 11 (GPIO1_A1, 3V, optional)\n6: CHG_INT -> pin 7 (GPIO1_A0, 3V)\n7: RFID_TX -> pin 21 (UART4_RX, 3V)\nDo NOT use pins 27/28 (I2C2 1.8V)" (at 30.48 104.14 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 38226910-8e77-5d6e-9c1f-76a6d35376fa)
  )

